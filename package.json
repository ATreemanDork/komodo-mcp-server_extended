{
  "name": "komodo-mcp-server_extended",
  "version": "2.0.0",
  "description": "Comprehensive Model Context Protocol server for the Komodo container-orchestration API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "komodo-mcp": "build/index.js"
  },
  "types": "build/index.d.ts",
  "mcpName": "io.github.ATreemanDork/komodo-mcp-server_extended",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATreemanDork/komodo-mcp-server_extended.git"
  },
  "homepage": "https://github.com/ATreemanDork/komodo-mcp-server_extended#readme",
  "bugs": {
    "url": "https://github.com/ATreemanDork/komodo-mcp-server_extended/issues"
  },
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.prod.json",
    "start": "node build/index.js",
    "dev": "npm run build && node build/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build coverage test-results *.tsbuildinfo",
    "clean:all": "rm -rf build node_modules coverage test-results *.tsbuildinfo",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file=.env node_modules/.bin/vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "komodo",
    "docker",
    "docker-compose",
    "container",
    "devops",
    "orchestration",
    "automation",
    "typescript"
  ],
  "author": "ATreemanDork <albantreeman@gmail.com>",
  "contributors": [
    "Marcel Pfennig / MP-Tool (original work: github.com/MP-Tool/komodo-mcp-server)"
  ],
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "README.md",
    "FORK_NOTES.md",
    "LICENSE.txt"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "komodo_client": "^2.1.1",
    "zod": "^3.25.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^25.0.9",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  }
}
