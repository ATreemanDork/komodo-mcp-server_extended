# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it, never paste its contents into chat/logs.

# ═══════════════════════════════════════════════════════════════════════════
# RUNTIME — required to run the server
# ═══════════════════════════════════════════════════════════════════════════

# ── Komodo Core connection ───────────────────────────────────────────────
KOMODO_URL=

# Authentication — pick ONE method:
#   1. API key/secret (recommended)
KOMODO_API_KEY=
KOMODO_API_SECRET=
#   2. Username + password
# KOMODO_USERNAME=
# KOMODO_PASSWORD=
#   3. Pre-existing JWT (e.g. from an OIDC / GitHub / Google OAuth browser login)
# KOMODO_JWT_TOKEN=
#
# Docker secrets: every credential above also has a *_FILE variant that reads
# the value from a file path (the plain env var wins if both are set), e.g.
#   KOMODO_API_KEY_FILE=/run/secrets/komodo_api_key
#   KOMODO_API_SECRET_FILE=/run/secrets/komodo_api_secret

# ── MCP server transport ──────────────────────────────────────────────────
# stdio | http  ("https" is not implemented yet — see src/index.ts)
MCP_TRANSPORT=stdio
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8000
MCP_MAX_SESSIONS=100
# Idle HTTP session timeout — sessions with no activity this long are evicted
# to free their slot. Accepts durations ('30m') or plain ms.
MCP_SESSION_IDLE_MS=30m

# ── Guardrail dry-run/confirm tokens (src/guardrails/confirm.ts) ─────────
# Optional. Leave unset — a random key is generated at process boot, which
# is fine (tokens only need to survive seconds-to-minutes). Set this only
# if you want a confirm token to remain valid across a server restart.
GUARDRAIL_HMAC_SECRET=

# ── Optional tuning ───────────────────────────────────────────────────────
# API_TIMEOUT_MS=30s                # Komodo API request timeout (duration or ms)
# KOMODO_RESOURCE_TTL_INFO=15m      # TTL for ephemeral info/inspect resource links
# KOMODO_RESOURCE_TTL_LOGS=2m       # TTL for ephemeral log resource links
# KOMODO_RESOURCE_MAX_ENTRIES=1000  # max ephemeral resource entries kept in memory

# ═══════════════════════════════════════════════════════════════════════════
# TEST-ONLY — needed only to run `npm run test:integration`, never at runtime
# ═══════════════════════════════════════════════════════════════════════════
# The integration suite talks to a REAL Komodo instance and creates/destroys
# disposable resources. Point it at a throwaway server you control.

# Object id of a Komodo Server the tests can target (server-scoped suites
# skip themselves if this is unset). Find it via `komodo_server_list`.
KOMODO_TEST_SERVER_ID=

# Gitea test org/repo — only exercised by Repo/Builder/Provider coverage.
GITEA_URL=
GITEA_TOKEN=
GITEA_TEST_ORG=
GITEA_TEST_REPO=
