{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ATreemanDork/komodo-mcp-server_extended",
  "title": "Komodo MCP Server (extended)",
  "description": "MCP server for the Komodo container-orchestration API — extends the upstream MP-Tool server with Docker introspection, Tag, Provider, Builder, OnboardingKey, UserGroup, Permission and Toml tools, a guardrail layer, and tool-output secret redaction.",
  "websiteUrl": "https://github.com/ATreemanDork/komodo-mcp-server_extended",
  "repository": {
    "url": "https://github.com/ATreemanDork/komodo-mcp-server_extended",
    "source": "github"
  },
  "version": "2.0.1",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/atreemandork/komodo-mcp-server_extended:2.0.1",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KOMODO_URL",
          "description": "Komodo Core API URL",
          "placeholder": "https://komodo.example.com",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "KOMODO_API_KEY",
          "description": "API key for key-based authentication",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "KOMODO_API_SECRET",
          "description": "API secret for key-based authentication",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/atreemandork/komodo-mcp-server_extended:2.0.1",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:{MCP_PORT}/mcp"
      },
      "environmentVariables": [
        {
          "name": "KOMODO_URL",
          "description": "Komodo Core API URL",
          "placeholder": "https://komodo.example.com",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "KOMODO_API_KEY",
          "description": "API key (recommended auth). Alternatively use KOMODO_USERNAME + KOMODO_PASSWORD, or KOMODO_JWT_TOKEN.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "KOMODO_API_SECRET",
          "description": "API secret (paired with KOMODO_API_KEY).",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MCP_PORT",
          "description": "Port the Streamable HTTP transport listens on (the /mcp endpoint)",
          "placeholder": "8000",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
